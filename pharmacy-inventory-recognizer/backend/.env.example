# ---- PostgreSQL (default) ----------------------------------------------------
# Change YOURPASSWORD to the password you set when installing PostgreSQL.
DATABASE_URL=postgresql+psycopg://postgres:YOURPASSWORD@localhost:5432/pharmacy

# ---- SQLite fallback (no install) -------------------------------------------
# If you don't want to install PostgreSQL, comment the line above and uncomment:
# DATABASE_URL=sqlite:///./pharmahub.db
